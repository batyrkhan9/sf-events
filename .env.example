# Copy to .env and fill in. .env is gitignored.
#
# Every value here is optional — the pipeline runs without any of them.

# The professional-events filter. Extraction itself is free (parsed from
# the page), so without this the digest still works, just unfiltered.
# Roughly $0.005 per run. Skip the call entirely with --no-filter.
ANTHROPIC_API_KEY=

# Digest delivery. Without these the digest prints to the console.
# Both come from @BotFather — see the README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
